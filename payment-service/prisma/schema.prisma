generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id        String   @id @default(uuid())
  orderId   String   @unique
  amount    Float
  status    String   @default("SUCCESS") // SUCCESS, FAILED
  createdAt DateTime @default(now())
}
